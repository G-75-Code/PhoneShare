<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PhoneShare Setup" Width="540" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True" FontFamily="Segoe UI" FontSize="14">
  <Window.Resources>
    $STYLES$
  </Window.Resources>

  <Grid Background="{StaticResource Bg}" TextElement.Foreground="{StaticResource Text}" TextOptions.TextFormattingMode="Display">
    <Grid.RowDefinitions>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <StackPanel Margin="34,32,34,30">
      <StackPanel Orientation="Horizontal">
        <Border Width="56" Height="56" CornerRadius="15" Background="{StaticResource Accent}">
          <TextBlock Text="&#xE8EA;" FontFamily="{StaticResource Icons}" FontSize="27" Foreground="White"
                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
          <TextBlock Text="PhoneShare" FontSize="25" FontWeight="Bold"/>
          <TextBlock x:Name="VersionText" Foreground="{StaticResource Muted}" FontSize="13"/>
        </StackPanel>
      </StackPanel>

      <TextBlock Text="Send files from this laptop to your phone over Wi‑Fi. Fast, no cable, no internet needed."
                 TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,20,0,0"/>

      <StackPanel x:Name="OptionsPanel" Margin="0,26,0,0">
        <TextBlock Text="INSTALL TO" Style="{StaticResource Label}"/>
        <TextBlock x:Name="PathText" FontFamily="Consolas" Margin="0,5,0,20"/>
        <CheckBox x:Name="DesktopChk" Content="Create a desktop shortcut" IsChecked="True"/>
        <CheckBox x:Name="SendToChk" Content="Add “Send to → Phone” to the right‑click menu" IsChecked="True" Margin="0,12,0,0"/>
      </StackPanel>

      <Border x:Name="DonePanel" Visibility="Collapsed" Margin="0,26,0,0" Style="{StaticResource CardBorder}">
        <StackPanel Orientation="Horizontal">
          <Border Width="40" Height="40" CornerRadius="20" Background="{StaticResource Ok}">
            <TextBlock Text="&#xE73E;" FontFamily="{StaticResource Icons}" FontSize="18" Foreground="White"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="PhoneShare is installed" FontSize="16" FontWeight="SemiBold"/>
            <TextBlock Text="Right‑click any file  →  Send to  →  Phone" Foreground="{StaticResource Muted}" FontSize="13" Margin="0,2,0,0"/>
          </StackPanel>
        </StackPanel>
      </Border>
    </StackPanel>

    <Border Grid.Row="1" Background="{StaticResource Card}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="34,16">
      <DockPanel>
        <Button x:Name="InstallBtn" DockPanel.Dock="Right" Style="{StaticResource Primary}" Content="Install" MinWidth="150"/>
        <Button x:Name="CancelBtn" DockPanel.Dock="Right" Style="{StaticResource Btn}" Content="Cancel" MinWidth="96" Margin="0,0,10,0"/>
        <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,12,0"/>
      </DockPanel>
    </Border>
  </Grid>
</Window>
