<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PhoneShare" Width="1040" Height="700" MinWidth="860" MinHeight="600"
        WindowStartupLocation="CenterScreen" AllowDrop="True" UseLayoutRounding="True"
        FontFamily="Segoe UI" FontSize="14">
  <Window.Resources>
    $STYLES$
  </Window.Resources>

  <Grid Background="{StaticResource Bg}" TextElement.Foreground="{StaticResource Text}" TextOptions.TextFormattingMode="Display">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="340"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- Left: app name + status, QR code, live speed -->
    <DockPanel Margin="22,20,10,22">
      <Grid DockPanel.Dock="Top" Margin="2,0,0,18">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border Width="42" Height="42" CornerRadius="11" Background="{StaticResource Accent}">
          <TextBlock Text="&#xE8EA;" FontFamily="{StaticResource Icons}" FontSize="21" Foreground="White"
                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
          <TextBlock Text="PhoneShare" FontSize="19" FontWeight="Bold"/>
          <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
            <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="{StaticResource Ok}" VerticalAlignment="Center"/>
            <TextBlock x:Name="StatusText" Text="Starting…" Margin="7,0,0,0" FontSize="12" Foreground="{StaticResource Muted}"/>
          </StackPanel>
        </StackPanel>
      </Grid>

      <Border DockPanel.Dock="Top" Style="{StaticResource CardBorder}">
        <StackPanel>
          <TextBlock Text="SCAN WITH YOUR PHONE CAMERA" Style="{StaticResource Label}"/>
          <Border Background="White" CornerRadius="10" Padding="6" Margin="0,14,0,0" HorizontalAlignment="Center">
            <Image x:Name="QrImage" Width="170" Height="170" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
          </Border>
          <Grid Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="UrlText" Text="…" FontFamily="Consolas" FontSize="14" FontWeight="SemiBold"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            <Button x:Name="CopyBtn" Grid.Column="1" Style="{StaticResource Ghost}" Content="&#xE8C8;"
                    FontFamily="{StaticResource Icons}" FontSize="14" Padding="9,7" ToolTip="Copy link"/>
          </Grid>
          <TextBlock x:Name="OtherText" FontSize="11" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,2,0,0"/>
          <TextBlock Text="Phone and laptop must be on the same Wi‑Fi or hotspot." FontSize="12"
                     Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,0"/>
        </StackPanel>
      </Border>

      <Border Style="{StaticResource CardBorder}" Margin="0,14,0,0">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="TRANSFER SPEED" Style="{StaticResource Label}"/>
            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
              <TextBlock x:Name="SpeedText" Text="0.0" FontSize="32" FontWeight="Bold"/>
              <TextBlock Text="MB/s" FontSize="14" Foreground="{StaticResource Muted}" VerticalAlignment="Bottom" Margin="6,0,0,8"/>
            </StackPanel>
            <TextBlock x:Name="SpeedSub" Text="Waiting for your phone" FontSize="12" Foreground="{StaticResource Muted}"/>
          </StackPanel>
          <Canvas x:Name="Graph" Margin="0,12,0,0" MinHeight="36" ClipToBounds="True">
            <Polygon x:Name="GraphFill" Fill="{StaticResource AccentSoft}"/>
            <Polyline x:Name="GraphLine" Stroke="{StaticResource Accent}" StrokeThickness="2" StrokeLineJoin="Round"/>
          </Canvas>
        </DockPanel>
      </Border>
    </DockPanel>

    <!-- Right: drop zone + shared files -->
    <Grid Grid.Column="1" Margin="10,20,22,22">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <Grid>
        <Rectangle x:Name="DropRect" RadiusX="12" RadiusY="12" StrokeThickness="1.5" StrokeDashArray="6 4"
                   Stroke="{StaticResource Line}" Fill="{StaticResource Card}"/>
        <StackPanel Margin="0,26" HorizontalAlignment="Center" VerticalAlignment="Center">
          <TextBlock Text="&#xE898;" FontFamily="{StaticResource Icons}" FontSize="28" Foreground="{StaticResource Accent}" HorizontalAlignment="Center"/>
          <TextBlock Text="Drop files or folders here" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,10,0,3"/>
          <TextBlock Text="They show up on your phone straight away" FontSize="12" Foreground="{StaticResource Muted}"
                     HorizontalAlignment="Center" Margin="0,0,0,16"/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <Button x:Name="AddFilesBtn" Style="{StaticResource Primary}" Content="Add files"/>
            <Button x:Name="AddFolderBtn" Style="{StaticResource Btn}" Content="Add folder" Margin="10,0,0,0"/>
          </StackPanel>
        </StackPanel>
      </Grid>

      <DockPanel Grid.Row="1" Margin="4,22,0,10">
        <Button x:Name="ClearBtn" DockPanel.Dock="Right" Style="{StaticResource Ghost}" Content="Clear all" Padding="10,4"/>
        <TextBlock x:Name="ListTitle" Text="Shared files" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
      </DockPanel>

      <Border Grid.Row="2" Style="{StaticResource CardBorder}" Padding="6">
        <Grid>
          <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="&#xE8B7;" FontFamily="{StaticResource Icons}" FontSize="30" Foreground="{StaticResource Muted}" HorizontalAlignment="Center"/>
            <TextBlock Text="Nothing shared yet" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,10,0,4"/>
            <TextBlock Text="Tip: right‑click any file  →  Send to  →  Phone" FontSize="12" Foreground="{StaticResource Muted}" HorizontalAlignment="Center"/>
          </StackPanel>
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="FileList">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border x:Name="Row" Background="Transparent" CornerRadius="8" Padding="12,10">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                      </Grid.ColumnDefinitions>
                      <Border Width="40" Height="40" CornerRadius="9" Background="{StaticResource AccentSoft}" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource Icons}" FontSize="18"
                                   Foreground="{StaticResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                      </Border>
                      <StackPanel Grid.Column="1" Margin="14,0,14,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" ToolTip="{Binding FullPath}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Status}" Foreground="{Binding StatusBrush}" FontSize="12" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                        <ProgressBar Value="{Binding Progress, Mode=OneWay}" Maximum="100" Margin="0,7,0,0" Visibility="{Binding ProgressVisibility}"/>
                      </StackPanel>
                      <TextBlock Grid.Column="2" Text="{Binding SizeText}" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                      <Button Grid.Column="3" Style="{StaticResource Ghost}" Content="&#xE711;" FontFamily="{StaticResource Icons}"
                              FontSize="11" Tag="{Binding}" ToolTip="Stop sharing this file" VerticalAlignment="Center"/>
                    </Grid>
                  </Border>
                  <DataTemplate.Triggers>
                    <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                      <Setter TargetName="Row" Property="Background" Value="{StaticResource Hover}"/>
                    </Trigger>
                  </DataTemplate.Triggers>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Window>
